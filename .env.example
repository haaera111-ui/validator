# ============================================
# VALIDATOR - Environment Configuration Template
# Copy this to .env and fill in your values
# DO NOT commit .env to version control
# ============================================

# ==================== DATABASE ====================
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=validator

# ==================== STORAGE ====================
# Local folder where uploaded resume files are stored
STORAGE_PATH=./storage

# ==================== OCR / TESSERACT ====================
# Windows example (with escaped backslashes):
# TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# 
# Linux example:
# TESSERACT_PATH=/usr/bin/tesseract
#
# If left empty, pytesseract will search system PATH
TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

# ==================== NLP / SPACY ====================
# spaCy English model name (must be downloaded: python -m spacy download en_core_web_sm)
SPACY_MODEL=en_core_web_sm

# ==================== FEATURE FLAGS ====================
ENABLE_LINKEDIN_MODULE=False
ENABLE_LLM_MODULE=False
ENABLE_BACKGROUND_CHECKS=False

# ==================== API ====================
DEBUG=False
